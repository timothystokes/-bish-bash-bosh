{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hodgepodge-config",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter", "model", "allowedPaths"],
  "properties": {
    "adapter": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["interview", "forward", "reverse", "brownfield", "test-hardening", "clean-room"] },
    "requireTestPlan": { "type": "boolean" },
    "maxQaCycles": { "type": "integer", "minimum": 1 },
    "hardenCommand": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
