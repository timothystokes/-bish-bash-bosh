{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hodgepodge-config",
  "type": "object",
  "additionalProperties": false,
  "required": ["targetRepo", "roles", "budgets", "allowedPaths"],
  "properties": {
    "targetRepo": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "required": ["build"],
      "additionalProperties": { "$ref": "#/definitions/role" }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTokens", "maxCostUsd", "maxWallClockSeconds", "maxIterations"],
      "properties": {
        "maxTokens": { "type": "integer", "minimum": 1 },
        "maxCostUsd": { "type": "number", "exclusiveMinimum": 0 },
        "maxWallClockSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxIterations": { "type": "integer", "minimum": 1 }
      }
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
