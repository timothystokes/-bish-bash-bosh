{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hodgepodge-config",
  "type": "object",
  "additionalProperties": false,
  "required": ["targetRepo", "roles", "budgets", "allowedPaths"],
  "properties": {
    "targetRepo": { "type": "string", "minLength": 1 },
    "hodgepodge": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "required": ["build"],
      "properties": {
        "build": { "$ref": "#/definitions/role" },
        "qa": { "$ref": "#/definitions/role" }
      },
      "additionalProperties": { "$ref": "#/definitions/role" }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWallClockSeconds", "maxIterations"],
      "properties": {
        "maxWallClockSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxIterations": { "type": "integer", "minimum": 1 }
      }
    },
    "mode": { "enum": ["interview", "forward", "reverse", "brownfield", "test-hardening", "clean-room"] },
    "requireTestPlan": { "type": "boolean" },
    "maxQaCycles": { "type": "integer", "minimum": 1 },
    "hardenCommand": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
