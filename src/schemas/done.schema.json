{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hodgepodge-done",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "suite", "types", "requirements", "gaps"],
  "properties": {
    "ok": { "type": "boolean" },
    "suite": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean" } } },
    "types": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean" } } },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "spec", "implementation", "status", "tests"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "spec": { "type": "string", "minLength": 1 },
          "implementation": { "enum": ["none", "partial", "implemented"] },
          "status": { "enum": ["passing", "failing", "unproven"] },
          "tests": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } }
  }
}
